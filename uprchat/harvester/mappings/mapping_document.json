{
    "name": "basic",
    "description": "basic mapping raw data",
    "entities": [
        {
            "name": "Document",
            "mapping": {
                "required": [
                    "id",
                    "summary",
                    "recollection"
                ],
                "_vectorize": {
                    "strategy": "Document Embeddings",
                    "values": [
                        "id",
                        "summary"
                    ],
                    "phrase": "documento en :id es sobre :summary"
                },
                "_class": "Document",
                "properties": {
                    "id": "id",
                    "summary": "summary",
                    "stored_in": "stored_in",
                    "recollection": "recollection",
                    "source": {
                        "__relation": "name",
                        "__predicate": "COLLECTED_FROM",
                        "__target": "Source"
                    }
                }
            }
        }
    ]
}