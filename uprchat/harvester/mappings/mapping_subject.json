{
    "name": "basic",
    "description": "Mapping for basic entities",
    "entities": [
        {
            "name": "Subject",
            "mapping": {
                "required": [
                    "id",
                    "about"
                ],
                "_vectorize": {
                    "strategy": "Document Embeddings",
                    "values": [
                        "id",
                        "about"
                    ],
                    "phrase": "la asignatura :id es sobre :about"
                },
                "_class": "Subject",
                "properties": {
                    "identifiers": {
                        "__predicate": "idtype",
                        "__object": "id"
                    },
                    "id": "id",
                    "about": "about",
                    "subject": {
                        "__relation": "id",
                        "__predicate": "RELATED_SUBJECTS",
                        "__target": "Subject",
                        "id": "id"
                    },
                    "page": {
                        "__relation": "id",
                        "__predicate": "REFERENCED_IN",
                        "__target": "Page",
                        "id": "id"
                    }
                }
            }
        }
    ]
}