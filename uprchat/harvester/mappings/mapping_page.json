{
    "name": "basic",
    "description": "basic mapping raw data",
    "entities": [
        {
            "name": "Page",
            "mapping": {
                "required": [
                    "id",
                    "summary", 
                    "recollection"
                ],
                "_vectorize": {
                    "strategy": "Document Embeddings",
                    "values": [
                        "title",
                        "body"
                    ],
                    "phrase": "la pagina :title tiene contenido acerca de :body"
                },
                "_class": "Page",
                "properties": {
                    "identifiers": {
                        "__predicate": "idtype",
                        "__object": "id"
                    },
                    "id": "id",
                    "title": "title",
                    "summary": "summary",
                    "body": "body",
                    "stored_in": "stored_in",
                    "recollection": "recollection",
                    "links": "links",
                    "source": {
                        "__relation": "name",
                        "__predicate": "COLLECTED_FROM",
                        "__target": "Source"
                    }
                }
            }
        }
    ]
}