{
    "name": "basic",
    "description": "basic mapping raw data",
    "entities": [
        {
            "name": "Page",
            "mapping": {
                "required": [
                    "url"
                ],
                "_vectorize": {
                    "strategy": "Document Embeddings",
                    "values": [
                        "title",
                        "summary"
                    ],
                    "phrase": "la pagina :title tiene contenido acerca de :summary"
                },
                "_class": "",
                "properties": {
                    "url": "url",
                    "title": "title",
                    "summary": "summary",
                    "stored_in": "stored_in"
                }
            }
        },
